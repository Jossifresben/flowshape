{
  "name": "flowshape",
  "private": true,
  "version": "1.4.0",
  "description": "Turn mathematics into art: 35 deterministic pattern generators, composed into print-ready posters or driven by audio. Pure SVG, in the browser.",
  "license": "MIT",
  "author": "Jose \"Jossi\" Fresco Benaim (https://orcid.org/0009-0000-2026-0836)",
  "homepage": "https://flowshape.art",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jossifresben/flowshape.git"
  },
  "bugs": {
    "url": "https://github.com/Jossifresben/flowshape/issues"
  },
  "keywords": [
    "generative-art",
    "svg",
    "poster",
    "mathematics",
    "deterministic",
    "typescript",
    "vite"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run thumbs && npm run refs && npm run zenodo",
    "build": "tsc --noEmit && vite build",
    "thumbs": "vite-node scripts/build-thumbs.ts",
    "refs": "vite-node scripts/build-references.ts",
    "zenodo": "vite-node scripts/build-zenodo.ts",
    "og": "vite-node scripts/build-og.ts && node scripts/shoot-og.mjs",
    "set-version": "node scripts/set-version.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-node": "^3.2.4",
    "vitest": "^3.0.0"
  }
}
